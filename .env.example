# Azure Blob Storage / ADLS Gen2 connection string for the storage account
# (Storage account must have hierarchical namespace enabled for full ADLS Gen2 semantics)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net

# Blob container name (will be created automatically on first write)
AZURE_STORAGE_CONTAINER_NAME=aqi-datalake

# Root path prefix inside the container (default: aqi-history)
AQI_DATA_ROOT_PATH=aqi-history

# AQICN API key – get yours free at https://aqicn.org/data-platform/token/
AQICN_API_KEY=<your-aqicn-token>

# Collector workflow: URL of your Azure Static Web App (set as a GitHub Actions secret)
# COLLECTOR_API_URL=https://<your-static-web-app>.azurestaticapps.net
